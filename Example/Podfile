platform :ios, '15.0'

target 'UseSenseExample' do
  # MediaPipe (pulled in transitively via UseSenseSDK -> UseSenseMediaPipe) ships
  # static binaries, so the app must link statically. Plain `use_frameworks!`
  # fails pod install with "transitive dependencies that include statically
  # linked binaries".
  use_frameworks! :linkage => :static

  # Local pod for development. UseSenseSDK depends on UseSenseMediaPipe (the
  # vendored, Info.plist-patched MediaPipe frameworks), resolved from trunk —
  # so face mesh works with no per-app pod or pre_install patch hook.
  pod 'UseSenseSDK', :path => '../'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
